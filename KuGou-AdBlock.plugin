#!name = 酷狗音乐去广告 v2.0.0
#!desc = 兼容脚本版：开屏、补发、横幅和推广清理，拦截酷狗 SDK 广告策略。需启用脚本及 MitM；日志前缀 KuGouAdBlock 2.0.0。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!date = 2026-10-27

[Script]
# 广告上报与直播广告专用接口，在请求阶段返回空成功响应。
http-request ^https?:\/\/(?:gateway\.kugou\.com\/(?:ads\.gateway\/v3\/stat_(?:expose|click)|adp\/stat\/v1\/expose)|fx\.service\.kugou\.com\/mfx-kugoulive\/ad\/query_all)(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/KuGou-AdBlock.v2.js,timeout=10,tag=酷狗v2广告请求,enable=true,argument="debug=1"

# 此 SDK 响应带加密标记，按 URL 和 User-Agent 识别后仅阻断酷狗的广告策略请求。
http-request ^https?:\/\/mc\.tencentmusic\.com\/sdk\/ad\/strategies(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/KuGou-AdBlock.v2.js,timeout=10,tag=酷狗v2广告SDK,enable=true,argument="debug=1"

# 处理已观察到的广告响应，保留广告列表以外的字段。
http-response ^https?:\/\/gateway\.kugou\.com\/(?:ads\.gateway\/(?:v4\/mobile_splash|v3\/(?:mine_link|mobile_down)|v2\/(?:mobile_link|task_center_entrance|sidebar_link|sidebar_top_card|home_card))|(?:adservice|ads\.service)\/v3\/vip_center|adp\/ad\/v1\/(?:mine_top_banner|multi_page_pendant|home_combine))(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/KuGou-AdBlock.v2.js,requires-body=true,timeout=10,tag=酷狗v2广告响应,enable=true,argument="debug=1"
http-response ^https?:\/\/adserviceretry\.kglink\.cn\/v4\/mobile_splash_sort(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/KuGou-AdBlock.v2.js,requires-body=true,timeout=10,tag=酷狗v2开屏补发,enable=true,argument="debug=1"

# 可选运营弹窗，默认关闭；在 Loon 中启用此条脚本时可能同时隐藏运营提示。
http-response ^https?:\/\/(?:gateway\.kugou\.com\/aterouter\/v2\/get_dialog|vipdress\.kugou\.com\/v1\/dress_sales\/get_popup_for_package)(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/KuGou-AdBlock.v2.js,requires-body=true,timeout=10,tag=酷狗v2可选运营弹窗,enable=false,argument="popups=1&debug=1"

[Mitm]
hostname = gateway.kugou.com,adserviceretry.kglink.cn,fx.service.kugou.com,mc.tencentmusic.com,vipdress.kugou.com

#!name = 雷神加速器开屏和横幅去广告 v1.0.0
#!desc = 清理本次抓包中的横幅及促销位，并尝试关闭开屏 ToBid 配置。需开启复写和 MitM；开屏效果待实测。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!system = iOS,iPadOS
#!loon_version = 3.5.1(978)
#!date = 2026-10-27
#!tag = 去广告

[Argument]
banners = switch,true,type=boolean,tag=横幅和促销位,desc=移除首页及其他页面的横幅和优惠推广位
splash = switch,true,type=boolean,tag=尝试关闭开屏,desc=将开屏字典中 ToBid 标记从1改为0，关闭语义依据字段推断且待实测

[Rewrite]
# 横幅和促销位；保留成功状态、时间及响应中的其他字段。
response if ${banners} == true && ${url} ~= /^https?:\/\/opapi\.xxghh\.biz\/nn-assist\/banner\/(?:list|multiType\/list)(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .success == true then if (.retData | type) == \"array\" then .retData = [] else . end else . end")

# 开屏字典中的 ToBid 标记：1 改为 0 是根据字段推断的关闭方式，需手机实测。
response if ${splash} == true && ${url} ~= /^https?:\/\/opapi\.xxghh\.biz\/common\/comm\/dict\/getDictItems\/leigod_app_openadv(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .success == true then if (.retData | type) == \"array\" then .retData |= map(if type == \"object\" then if .text == \"tobid\" and .value == \"1\" then .value = \"0\" else . end else . end) else . end else . end")

# 启动聚合配置中同一开屏字典；不清空其他业务配置。
response if ${splash} == true && ${url} ~= /^https?:\/\/opapi\.xxghh\.biz\/nn-assist\/global\/getStartDict(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .success == true then if (.retData | type) == \"object\" and (.retData.leigod_app_openadv | type) == \"array\" then .retData.leigod_app_openadv |= map(if type == \"object\" then if .text == \"tobid\" and .value == \"1\" then .value = \"0\" else . end else . end) else . end else . end")

[Mitm]
hostname = opapi.xxghh.biz

#!name = 哔哩哔哩开屏和横幅去广告 v1.3.1（复写＋播放页脚本）
#!desc = 开屏 list/show 改为本地成功空响应；品牌、活动、首页保留原生复写，播放页保留辅助脚本。需开启复写、脚本及 MitM；实际展示待手机验证。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!system = iOS,iPadOS
#!loon_version = 3.5.1(988)
#!date = 2026-10-30
#!tag = 去广告,哔哩哔哩

[Rewrite]

# 开屏广告与展示计划：在上游请求前返回本地空数据；不直接删除 App 已有缓存。
# 原生 Mock 用法：https://nsloon.app/docs/Rewrite/rewrite_v2/#mock-响应-body
response if ${request.method} == "GET" && ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show)(?:\?|$)/ then response.body.mock("json", "{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":30,\"pull_interval\":900,\"keep_ids\":[],\"list\":[],\"show\":[],\"splash_request_id\":\"\"}}", 200) | response.header.set("X-Bilibili-AdBlock", "1.3.1-local-splash") | response.header.set("Cache-Control", "no-store")

# 品牌启动画面及预加载
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then (if (.data.list | type) == \"array\" then .data.list = [] else . end | if (.data.preload | type) == \"array\" then .data.preload = [] else . end) | (if (.data.forcibly | type) == \"boolean\" then .data.forcibly = false else . end) | (if (.data.force_show_times | type) == \"number\" then .data.force_show_times = 0 else . end) else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.1-hybrid")

# 活动启动画面；保留账号数据
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/event\/list2(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.event_list | type) == \"array\" then .data.event_list = [] else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.1-hybrid")

# 整块首页轮播、会员购推广及信息流广告；保留普通视频和直播
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\/story)?(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.items | type) == \"array\" then .data.items |= map(select(if type != \"object\" then true else (((if (.card_type | type) == \"string\" then (.card_type | test(\"^(cm_|banner)\")) else false end) or .card_goto == \"banner\" or .card_goto == \"mall\" or .goto == \"mall\" or (if (.ad_info | type) == \"object\" then (.ad_info | length) > 0 else false end) or (if (.uri | type) == \"string\" then (.uri | ascii_downcase | test(\"^(https?://mall[.]bilibili[.]com|bilibili://mall)([/?#]|$)\")) else false end)) | not) end)) else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.1-hybrid")

# 竖屏流独立广告列表
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\/cart(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.ads | type) == \"array\" then .data.ads = [] else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.1-hybrid")

[Script]
# 仅处理抓包确认的三个 gRPC 接口；播放地址与弹幕接口不在匹配范围内。
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.viewunite\.v1\.View\/(?:View|RelatesFeed|PlayPause)(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/Bilibili-PlayerAds.v1.3.js,requires-body=true,binary-body-mode=true,timeout=10,tag=B站v1.3播放页广告,enable=true

[Mitm]
hostname = app.bilibili.com,grpc.biliapi.net

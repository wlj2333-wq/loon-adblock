#!name = 哔哩哔哩去广告 v1.4.0（含实验直播净化）
#!desc = 保留原开屏、首页与播放页处理；新增默认关闭的实验直播横幅及购物展示净化。公开字段先例不等于当前手机有效。需开启复写、脚本及 MitM。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!system = iOS,iPadOS
#!loon_version = 3.5.1(988)
#!date = 2026-11-04
#!tag = 去广告,哔哩哔哩

[Argument]
live_activity_banner = switch,false,tag=实验：直播活动横幅,desc=仅处理已识别房间信息字段；未获当前手机验证
live_shopping = switch,false,tag=实验：直播购物展示,desc=只关闭房间信息中已有的购物展示标志；不保证隐藏原生按钮
live_debug = switch,false,tag=直播诊断日志,desc=开启净化后仅记录处理数量和固定错误类别；不保存正文或参数

[Rewrite]

# 本次京东开屏的已确认视频：仅阻止此素材今后的 GET/HEAD 下载，无法删除 App 本地副本。
# 不按共享 CDN 域名或整个 ssaxcode 目录拦截；广告更换素材后需另行核对。
request if (${request.method} == "GET" || ${request.method} == "HEAD") && ${url} ~= /^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/jb\/2r\/n261028a210b9cll18b0cnj9e3ys2rjb-1-SiteTool_1080\.mp4(?:\?|$)/ then reject(403)

# 开屏广告与展示计划：在上游请求前返回本地空数据；不直接删除 App 已有缓存。
# 原生 Mock 用法：https://nsloon.app/docs/Rewrite/rewrite_v2/#mock-响应-body
response if ${request.method} == "GET" && ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show)(?:\?|$)/ then response.body.mock("json", "{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":30,\"pull_interval\":900,\"keep_ids\":[],\"list\":[],\"show\":[],\"splash_request_id\":\"\"}}", 200) | response.header.set("X-Bilibili-AdBlock", "1.3.2-local-splash") | response.header.set("Cache-Control", "no-store")

# 品牌启动画面及预加载
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then (if (.data.list | type) == \"array\" then .data.list = [] else . end | if (.data.preload | type) == \"array\" then .data.preload = [] else . end) | (if (.data.forcibly | type) == \"boolean\" then .data.forcibly = false else . end) | (if (.data.force_show_times | type) == \"number\" then .data.force_show_times = 0 else . end) else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.2-hybrid")

# 活动启动画面；保留账号数据
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/event\/list2(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.event_list | type) == \"array\" then .data.event_list = [] else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.2-hybrid")

# 整块首页轮播、会员购推广及信息流广告；保留普通视频和直播
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\/story)?(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.items | type) == \"array\" then .data.items |= map(select(if type != \"object\" then true else (((if (.card_type | type) == \"string\" then (.card_type | test(\"^(cm_|banner)\")) else false end) or .card_goto == \"banner\" or .card_goto == \"mall\" or .goto == \"mall\" or (if (.ad_info | type) == \"object\" then (.ad_info | length) > 0 else false end) or (if (.uri | type) == \"string\" then (.uri | ascii_downcase | test(\"^(https?://mall[.]bilibili[.]com|bilibili://mall)([/?#]|$)\")) else false end)) | not) end)) else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.2-hybrid")

# 竖屏流独立广告列表
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\/cart(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if type != \"object\" then . elif .code == 0 and (.data | type) == \"object\" then if (.data.ads | type) == \"array\" then .data.ads = [] else . end else . end") | response.header.set("X-Bilibili-AdBlock", "1.3.2-hybrid")

[Script]
# 仅处理抓包确认的三个 gRPC 接口；播放地址与弹幕接口不在匹配范围内。
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.viewunite\.v1\.View\/(?:View|RelatesFeed|PlayPause)(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/Bilibili-PlayerAds.v1.3.js,requires-body=true,binary-body-mode=true,timeout=10,tag=B站v1.3播放页广告,enable=true

# 默认关闭；仅白名单房间信息 GET 的成功 JSON 响应，不匹配播放流、弹幕或购物交易接口。
response if (${live_activity_banner} == true || ${live_shopping} == true) && ${request.method} == "GET" && ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom(?:\?[^#]*)?$/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/cc18268ba9cefb32856303737620bce04f2552d9/Bilibili-LiveClean.v1.0.js", {${live_activity_banner}, ${live_shopping}, ${live_debug}}) with requires_body=true, timeout=10, tag="B站实验直播净化"

[Mitm]
hostname = app.bilibili.com,grpc.biliapi.net,upos-sz-static.bilivideo.com,api.live.bilibili.com


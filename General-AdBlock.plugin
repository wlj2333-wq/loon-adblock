#!name = 通用广告平台屏蔽 v1.0.0
#!desc = 精选 27 组国内及海外广告平台，100 条域名拦截规则，含 TANX。纯规则，无需 JS 或 MitM；对经过 Loon 的所有 App 生效，可能影响看广告领奖和广告跳转。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!system = iOS,iPadOS,tvOS,macOS
#!date = 2026-10-29
#!tag = 去广告,通用
# SPDX-License-Identifier: GPL-3.0-only
# 平台及逐条来源：General-AdBlock-Platforms.md / general-adblock-domains.json
# 无法覆盖全部第一方广告、缓存广告、共享业务接口或目录外的域名。

[Rule]

# ===== 国内/出海 =====

# 阿里妈妈 TANX
DOMAIN-SUFFIX,tanx.com,REJECT

# 腾讯广告／优量汇
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT

#!name = 哔哩哔哩开屏和横幅去广告 v1.1.0（脚本版）
#!desc = 清理开屏、首页整块轮播、会员购推广卡片及信息流广告。需启用脚本和 MitM；日志前缀 BilibiliAdBlock 1.1.0。
#!author = wlj2333-wq
#!homepage = https://github.com/wlj2333-wq/loon-adblock
#!system = iOS,iPadOS
#!date = 2026-10-27
#!tag = 去广告,哔哩哔哩

[Script]
# 开屏、品牌启动画面与活动启动画面；保留广告列表以外的数据。
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show|brand\/list|event\/list2)(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/Bilibili-AdBlock.v1.1.js,requires-body=true,binary-body-mode=false,timeout=10,tag=B站v1.1开屏,enable=true

# 移除整块顶部轮播和广告推广卡片，保留普通视频与直播。
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\/story(?:\/cart)?)?(?:\?|$) script-path=https://raw.githubusercontent.com/wlj2333-wq/loon-adblock/main/Bilibili-AdBlock.v1.1.js,requires-body=true,binary-body-mode=false,timeout=10,tag=B站v1.1首页轮播和广告卡片,enable=true

[Mitm]
hostname = app.bilibili.com
